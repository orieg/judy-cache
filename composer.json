{
    "name": "orieg/judy-cache",
    "description": "PSR-16 cache backed by Judy arrays, with O(range) prefix invalidation. For long-running PHP (Octane, Swoole, RoadRunner, FrankenPHP workers).",
    "keywords": [
        "cache",
        "psr-16",
        "simple-cache",
        "judy",
        "sparse-array",
        "octane",
        "swoole",
        "roadrunner",
        "frankenphp",
        "prefix-invalidation"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/orieg/judy-cache",
    "authors": [
        {
            "name": "Nicolas Brousse",
            "email": "nicolas@brousse.info",
            "homepage": "https://nicolas.brousse.info"
        }
    ],
    "support": {
        "issues": "https://github.com/orieg/judy-cache/issues",
        "source": "https://github.com/orieg/judy-cache"
    },
    "require": {
        "php": ">=8.1",
        "psr/simple-cache": "^3.0",
        "orieg/judy-polyfill": "^2.5.2"
    },
    "require-dev": {
        "symfony/cache": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-judy": "The native extension: C-speed operations and lower memory (pie install orieg/judy)",
        "symfony/cache": "To use JudyAdapter as a Symfony Cache / PSR-6 pool"
    },
    "provide": {
        "psr/simple-cache-implementation": "3.0"
    },
    "autoload": {
        "psr-4": {
            "Orieg\\JudyCache\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
